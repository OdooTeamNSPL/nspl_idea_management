<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_idea_cancel_wizard" model="ir.ui.view">
        <field name="name">idea.cancel.wizard.form</field>
        <field name="model">idea.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Idea">
                <group>
                    <field name="reason"/>
                </group>
                <footer>
                    <button string="Cancel Idea" type="object" name="action_cancel_idea" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_idea_cancel_wizard" model="ir.actions.act_window">
        <field name="name">Cancel Idea</field>
        <field name="res_model">idea.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
