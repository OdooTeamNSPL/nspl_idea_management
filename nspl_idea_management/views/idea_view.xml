<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_idea_form" model="ir.ui.view">
        <field name="name">idea.idea.form</field>
        <field name="model">idea.idea</field>
        <field name="arch" type="xml">
            <form string="Ideas">
                <header>
                    <button name="action_request_confirmation" string="Request for Confirmation" type="object"
                            class="btn-primary"
                            invisible="state != 'new'"/>

<!--                    <button name="action_reject" string="Reject" type="object"-->
<!--                            class="btn-danger"-->
<!--                            invisible="not (state in ['pending', 'confirmed'])"/>-->

                    <button name="action_approve" string="Approve" type="object"
                            class="btn-success"
                            invisible="state != 'confirmed'"/>

                    <button name="%(action_idea_cancel_wizard)d" string="Cancel" type="action"
                            context="{'active_id': id}"
                            invisible="state in ['cancelled', 'approved']"/>

                    <field name="state" widget="statusbar" options="{'clickable': true}"
                           statusbar_visible="new,pending,confirmed,approved,done"/>
                </header>


                <sheet>
                    <field name="name" class="oe_title"/>

                    <group>
                        <group string="Related Persons">
                            <field name="idea_manager_id"/>
                            <field name="member_ids" widget="many2many_tags"/>
                            <field name="suggested_by_id"/>
                            <field name="responsible_ids" widget="many2many_tags"/>
                            <field name="created_by_id" readonly="1"/>
                        </group>

                        <group string="Related Information">
                            <field name="category_id"/>
                            <field name="project_id"/>
                            <field name="rating"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_idea_list" model="ir.ui.view">
        <field name="name">idea.idea.list</field>
        <field name="model">idea.idea</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="idea_manager_id"/>
                <field name="category_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_idea" model="ir.actions.act_window">
        <field name="name">Ideas</field>
        <field name="res_model">idea.idea</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
