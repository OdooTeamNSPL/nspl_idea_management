<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">

        <!-- Request for Confirmation Email -->
        <record id="email_template_idea_request_confirmation" model="mail.template">
            <field name="name">Idea Request for Confirmation</field>
            <field name="model_id" ref="model_idea_idea"/>
            <field name="subject">New Idea {{ object.name }}</field>
            <field name="email_from">{{ user.company_id.email or 'info@example.com' }}</field>
            <field name="email_to">{{ object.idea_manager_id.email }}</field>
            <field name="body_html" type="html">
                <html>
                    <body>
                        <p>Hello<t t-out="object.idea_manager_id.name or 'Manager'"/>,
                        </p>
                        <p>A new idea titled
                            <strong>
                                <t t-out="object.name"/>
                            </strong>
                            has been submitted for your confirmation.
                        </p>
                        <p>
                            <strong>Suggested By:</strong>
                            <t t-out="object.suggested_by_id.name or 'Unknown'"/>
                            <br/>
                            <strong>Description:</strong>
                            <br/>
                            <t t-out="object.description or 'No description provided.'"/>
                        </p>
                        <p>Please log in to the system to review and take necessary action.</p>
                        <br/>
                        <p>Regards,<br/>Idea Management System
                        </p>
                    </body>
                </html>
            </field>
        </record>

        <!-- Idea Cancelled Email -->
        <record id="email_template_idea_cancelled" model="mail.template">
            <field name="name">Idea Cancelled</field>
            <field name="model_id" ref="model_idea_idea"/>
            <field name="subject">Your Idea {{ object.name }} Has Been Cancelled</field>
            <field name="email_to">{{ object.suggested_by_id.email or object.created_by_id.email }}</field>
            <field name="body_html" type="html">
                <html>
                    <body>
                        <p>Hello
                            <t t-out="object.suggested_by_id.name or object.created_by_id.name"/>
                            ,
                        </p>
                        <p>Your idea
                            <strong>
                                <t t-out="object.name"/>
                            </strong>
                            has been <strong>cancelled</strong>.
                        </p>
                        <p>
                            <strong>Reason:</strong>
                            <t t-out="object.cancellation_reason or 'N/A'"/>
                        </p>
                        <br/>
                        <p>Regards,<br/>Idea Management System
                        </p>
                    </body>
                </html>
            </field>
        </record>

        <!-- Idea Approved Email -->
        <record id="email_template_idea_approved" model="mail.template">
            <field name="name">Idea Approved</field>
            <field name="model_id" ref="model_idea_idea"/>
            <field name="subject">Your Idea {{ object.name }} Has Been Approved</field>
            <field name="email_to">{{ object.suggested_by_id.email or object.created_by_id.email }}</field>
            <field name="body_html" type="html">
                <html>
                    <body>
                        <p>Hello
                            <t t-out="object.suggested_by_id.name or object.created_by_id.name"/>
                            ,
                        </p>
                        <p>Your idea
                            <strong>
                                <t t-out="object.name"/>
                            </strong>
                            has been <strong>approved</strong>.
                        </p>
                        <p>A task has been created under the project
                            <strong>
                                <t t-out="object.project_id.name or 'N/A'"/>
                            </strong>
                            .
                        </p>
                        <br/>
                        <p>Regards,<br/>Idea Management Team
                        </p>
                    </body>
                </html>
            </field>
        </record>

        <!-- Idea Rejected Email -->
        <record id="email_template_idea_rejected" model="mail.template">
            <field name="name">Idea Rejected</field>
            <field name="model_id" ref="model_idea_idea"/>
            <field name="subject">Your Idea {{ object.name }} Has Been Rejected</field>
            <field name="email_to">{{ object.suggested_by_id.email or object.created_by_id.email }}</field>
            <field name="body_html" type="html">
                <html>
                    <body>
                        <p>Hello
                            <t t-out="object.suggested_by_id.name or object.created_by_id.name"/>
                            ,
                        </p>
                        <p>Your idea
                            <strong>
                                <t t-out="object.name"/>
                            </strong>
                            has been <strong>rejected</strong>.
                        </p>
                        <p>
                            <strong>Reason:</strong>
                            <t t-out="object.rejection_reason or 'N/A'"/>
                        </p>
                        <br/>
                        <p>Regards,<br/>Idea Management Team
                        </p>
                    </body>
                </html>
            </field>
        </record>

    </data>
</odoo>
